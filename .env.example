# LifeOS Configuration
# NOTE: For production, LLM calls must go through a secure backend proxy to prevent exposing API keys.

# Gemini API Key (Prefix with EXPO_PUBLIC_ for Expo client access)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (default: gemini-1.5-flash)
EXPO_PUBLIC_LLM_MODEL=gemini-1.5-flash

# Intent identification confidence threshold (default: 0.6)
EXPO_PUBLIC_CONFIDENCE_THRESHOLD=0.6

